{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build:showcase",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/(signin|signup|verify|loading|home|fishSpecies|fishDetails|plantSpecies|plantDetails|waterTest|waterTestDetails|AskAIScreen|tank)", "destination": "/app.html" },
    { "source": "/tank/:id", "destination": "/app.html" }
  ]
}
